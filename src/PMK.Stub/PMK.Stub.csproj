<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Top-level "Protect Me Knight.exe" in the release folder. It only starts
    app\ProtectMeKnight.exe, so the ~200 runtime files can live in "app".
    .NET Framework 4.8 is built into Windows 10/11, so this stays a few KB.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Protect Me Knight</AssemblyName>
    <RootNamespace>PMK.Stub</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
</Project>
